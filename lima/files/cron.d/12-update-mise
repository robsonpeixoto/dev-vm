#!/bin/sh
# Upgrade mise to its latest apt-published version. mise's repo publishes no
# security suite for unattended-upgrades to match, and boot provisioning only
# installs it when missing, so this job is what keeps it current. Run by
# dev-vm-cron, never directly by cron. No apt-get update here:
# 05-upgrade-security refreshed the lists at the top of this tick. No lock
# timeout either — the runner's flock and the masked apt-daily timers leave
# nothing else driving apt.
set -eu
export DEBIAN_FRONTEND=noninteractive
apt-get install -y --only-upgrade mise
