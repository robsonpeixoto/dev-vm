#!/bin/sh
# Upgrade Docker to its latest apt-published version. Run by dev-vm-cron, never
# directly by cron. No apt-get update here: 05-upgrade-security refreshed the
# lists at the top of this tick. No lock timeout either — the runner's flock and
# the masked apt-daily timers leave nothing else driving apt.
set -eu
export DEBIAN_FRONTEND=noninteractive
apt-get install -y --only-upgrade \
    docker-ce docker-ce-cli containerd.io docker-ce-rootless-extras \
    docker-buildx-plugin docker-compose-plugin
