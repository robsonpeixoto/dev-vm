#!/bin/sh
# Upgrade neovim to its latest version published by ppa:neovim-ppa/stable.
# unattended-upgrades covers the Ubuntu security pockets only, so a PPA
# package needs its own job, same as Docker. Run by dev-vm-cron, never
# directly by cron. DPkg::Lock::Timeout makes apt-get wait for
# unattended-upgrades instead of failing on a held lock.
set -eu
export DEBIAN_FRONTEND=noninteractive
apt-get -o DPkg::Lock::Timeout=120 update
apt-get -o DPkg::Lock::Timeout=120 install -y --only-upgrade neovim
