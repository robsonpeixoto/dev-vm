#!/bin/sh
# Upgrade neovim to the latest official pre-built archive release. Neovim is not
# an apt package here, so neither unattended-upgrades nor apt ever updates it.
# Run by dev-vm-cron, never directly by cron. No apt, so no DPkg::Lock::Timeout.
set -eu
exec /usr/local/lib/dev-vm/install-neovim
