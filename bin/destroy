#!/usr/bin/env python3
"""Destroy a Lima dev VM and its GitHub SSH access.

Usage: bin/destroy [name]

- Deletes the Lima VM <name>.
- Deletes the GitHub key recorded in ~/.config/dev-vm/state.json plus any
  key titled <name>, via `gh`.
- Removes the key pair at lima/tmp/<name>.
- Drops the VM entry from the state file.

Each step is skipped with a message when there is nothing to remove, so a
partial destroy can be re-run.
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import devvm as d


def delete_vm(name):
    if not d.vm_exists(name):
        print(f"no VM {name!r}, skipping")
        return
    d.limactl("delete", "-f", name, capture=False)
    print(f"deleted VM {name}")


def delete_github_keys(name, entry):
    previous = entry.get("github_key_id")
    title = entry.get("github_key_title", name)
    d.check_scopes()
    targets = [k for k in d.list_keys() if k["title"] == title or k["id"] == previous]
    if not targets:
        print(f"no GitHub key for {name!r}, skipping")
        return
    for k in targets:
        d.delete_key(k["id"])
        print(f"deleted GitHub key {k['id']} ({k['title']})")


def delete_key_files(name, entry):
    default_key, default_pub = d.key_paths(name)
    paths = {default_key, default_pub}
    for field in ("private_key", "public_key"):
        if entry.get(field):
            paths.add(Path(entry[field]))
    removed = False
    for p in sorted(paths):
        if p.exists():
            p.unlink()
            print(f"removed {p}")
            removed = True
    if not removed:
        print(f"no key files at {default_key}, skipping")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("name", nargs="?", default="default", help="VM name")
    args = parser.parse_args()
    name = args.name

    d.check_name(name)
    entry = d.get_vm(name)

    delete_vm(name)
    delete_github_keys(name, entry)
    delete_key_files(name, entry)

    if d.drop_vm(name):
        print(f"removed {name} from {d.STATE_FILE}")
    else:
        print(f"no state entry for {name!r}, skipping")


if __name__ == "__main__":
    main()
