#!/usr/bin/env python3
"""Create an isolated Lima dev VM with SSH access to GitHub.

Usage: bin/create [name] [--create-ssh-key[=no]] [--dotfiles[=REPO]|--no-dotfiles]

- Generates an ed25519 key pair at lima/tmp/<name> (no passphrase).
- Registers the public key on GitHub with title <name> via `gh`, replacing
  any key recorded in the state file or sharing the same title.
- Starts the VM from lima/dev-vm.yaml; the template uploads the private key
  and ssh config into the guest, and provisioning fetches known_hosts.
- With dotfiles enabled, provisioning clones the bare repo to ~/.dotfiles in
  the guest and checks it out over $HOME. The repo comes from --dotfiles or
  from {"dotfiles": "<repo>"} in ~/.config/dev-vm/settings.json, which also
  turns dotfiles on by default for every VM.
- Records VM metadata (GitHub key id, key paths) in ~/.config/dev-vm/state.json.
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import devvm as d


def create_key(name):
    key, pub = d.key_paths(name)
    d.KEY_DIR.mkdir(parents=True, exist_ok=True)
    for p in (key, pub):
        p.unlink(missing_ok=True)
    d.run(["ssh-keygen", "-t", "ed25519", "-N", "", "-C", name, "-f", str(key)])
    print(f"created key {key}")
    return key, pub


def register_key(name, pub):
    previous = d.get_vm(name).get("github_key_id")
    for k in d.list_keys():
        if k["title"] == name or k["id"] == previous:
            d.delete_key(k["id"])
            print(f"deleted old GitHub key {k['id']} ({k['title']})")
    created = d.add_key(name, pub.read_text().strip())
    print(f"registered GitHub key {created['id']} ({name})")
    return created["id"]


def resolve_dotfiles(args):
    """CLI wins over settings.json; bare --dotfiles falls back to settings."""
    if args.no_dotfiles:
        return ""
    configured = d.load_settings().get("dotfiles") or ""
    repo = configured if args.dotfiles is None else (args.dotfiles or configured)
    if args.dotfiles == "" and not repo:
        d.die(f"--dotfiles needs a repo, or a \"dotfiles\" entry in {d.SETTINGS_FILE}")
    if repo:
        d.check_repo(repo)
    return repo


def start_vm(name, dotfiles):
    template = d.render_template(name)
    try:
        d.limactl("start", "--tty=false", "--name", name,
                  "--set", f'.param.DOTFILES_REPO = "{dotfiles}"',
                  str(template), capture=False)
    finally:
        template.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("name", nargs="?", default="default", help="VM name")
    parser.add_argument(
        "--create-ssh-key",
        nargs="?",
        const="yes",
        default=None,
        choices=["yes", "no"],
        help="yes: create and register a new key; no: reuse existing key; "
             "default: reuse if present, otherwise create",
    )
    parser.add_argument(
        "--dotfiles",
        nargs="?",
        const="",
        default=None,
        metavar="REPO",
        help="clone REPO as a bare repo and check it out over the guest $HOME; "
             "without REPO, use the \"dotfiles\" entry in settings.json",
    )
    parser.add_argument(
        "--no-dotfiles",
        action="store_true",
        help="skip dotfiles even when settings.json configures them",
    )
    args = parser.parse_args()
    name = args.name

    d.check_name(name)
    dotfiles = resolve_dotfiles(args)
    if d.vm_exists(name):
        d.die(f"VM {name!r} already exists; run: bin/destroy {name}")

    key, pub = d.key_paths(name)
    key_exists = key.exists() and pub.exists()
    mode = args.create_ssh_key or ("no" if key_exists else "yes")

    if mode == "no":
        if not key_exists:
            d.die(f"no key at {key}; rerun with --create-ssh-key")
        print(f"reusing key {key}")
    else:
        d.check_scopes()
        create_key(name)
        key_id = register_key(name, pub)
        d.put_vm(name, github_key_id=key_id, github_key_title=name,
                 private_key=str(key), public_key=str(pub))

    if dotfiles:
        print(f"installing dotfiles from {dotfiles}")
    start_vm(name, dotfiles)
    d.put_vm(name, template=str(d.TEMPLATE), started_at=d.now(),
             private_key=str(key), public_key=str(pub), dotfiles=dotfiles)
    print(f"state {d.STATE_FILE}")


if __name__ == "__main__":
    main()
